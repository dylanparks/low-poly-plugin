#!/bin/sh
# lp: the low-poly pipeline's command line (lib/lowpoly/cli.py). Finds a Python 3 and runs it isolated.
here="$(cd "$(dirname "$0")" && pwd)"
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
    exec "$py" -I "$here/../lib/lowpoly/cli.py" "$@"
  fi
done
echo "lp: needs Python 3.8 or newer on the PATH" >&2; exit 127
